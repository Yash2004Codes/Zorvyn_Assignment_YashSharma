{
  "name": "finance-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:server\"",
    "dev:next": "next dev",
    "dev:server": "nodemon --watch server/src --ext ts --exec \"tsx server/src/index.ts\"",
    "build": "next build",
    "start": "next start",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/index.js"
  },
